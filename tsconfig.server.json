{
  "compilerOptions": {
    "target": "ES2020",
    "module": "Node16",
    "moduleResolution": "node16",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "strict": false,
    "skipLibCheck": true,
    "outDir": "dist-server",
    "baseUrl": "."
  },
  "include": ["server/**/*"],
  "exclude": ["node_modules"]
}
